generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "cockroachdb"
  url      = env("DATABASE_URL")


  
}

// =======================================================
// ENUMS
// =======================================================
enum crdb_internal_region {
  aws_ap_south_1 @map("aws-ap-south-1")
}

enum UserType {
  STUDENT
  TEACHER
  ADMIN
}

enum ResearchWorkType {
  COPYRIGHT
  PATENT
  TRANSACTION
  CONFERENCE
  JOURNAL
  BOOK_CHAPTER
  GRANT_IN
  FDP
  CERTIFICATION
}

enum PublicationStatus {
  ACCEPTED
  COMMUNICATED
  PUBLISHED
}



enum ResearchPaperStatus {
  UPLOADED
  UNDER_REVIEW
  ACCEPTED
  REJECTED
}
enum ProjectType {
  PERSONAL
  COLLABORATIVE
  IN_IEDC
}


enum OngoingProjectStatus {
  ONGOING
  COMPLETED
  ACCEPTED
  REJECTED
}

// =======================================================
// BASE MODELS
// =======================================================

model User {
  id              String       @id @default(uuid())
  email           String?      @unique
  password        String?
  fullName        String
  userType        UserType
  image           String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  isVerified      Boolean      @default(false)
  resetToken      String?      @unique
  resetTokenExpiry DateTime?
  // Relations
  studentProfile  Student?
  teacherProfile  Teacher?
  researchWorks   ResearchWork[]
  achievements    Achievement[]
  advisedResearchPapers ResearchPaper[] @relation("ResearchPaperAdvisors")
  memberOfResearchPapers ResearchPaper[] @relation("ResearchPaperMembers")
  advisedOngoingProjects OngoingProject[] @relation("OngoingProjectAdvisors")
  memberOfOngoingProjects OngoingProject[] @relation("OngoingProjectMembers")
  // NextAuth relations
  accounts        Account[]
  sessions        Session[]
}

model Student {
  id             String      @id @default(uuid())
  userId         String      @unique
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  section        String
  year           Int
  batch          String
  department     String
  rollNumber     String      @unique

  researchPapers  ResearchPaper[]
  ongoingProjects OngoingProject[]
}

model Teacher {
  id              String      @id @default(uuid())
  userId          String      @unique
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  affiliation     String
  designation     String
  subjectOfInterest String?
  officialMail    String?
  address         String?
}

// =======================================================
// RESEARCH WORK
// =======================================================

model ResearchWork {
  id           String             @id @default(uuid())
  title        String
  type         ResearchWorkType
  uploadedById String
  uploadedBy   User               @relation(fields: [uploadedById], references: [id])
  isPublic     Boolean            @default(false)
  createdAt    DateTime           @default(now()) 
  updatedAt    DateTime           @updatedAt
  isDeleted    Boolean            @default(false)
  deletedAt    DateTime?

  // Relations
  authors      Author[]
  keywords     String[]
  copyright    Copyright?
  patent       Patent?
  transaction  Transaction?
  conference   Conference?
  journal      Journal?
  bookChapter  BookChapter?
  grantIn      GrantIn?
  fdp          FDP?
  certification Certification?
}

model Author {
  id             String       @id @default(uuid())
  name           String
  researchWorkId String
  researchWork   ResearchWork @relation(fields: [researchWorkId], references: [id], onDelete: Cascade)
}


// =======================================================
// RESEARCH WORK TYPES
// =======================================================

model Copyright {
  id               String       @id @default(uuid())
  researchWorkId   String       @unique
  researchWork     ResearchWork @relation(fields: [researchWorkId], references: [id], onDelete: Cascade)
  inventors        String
  filedAt          DateTime?    @db.Date
  submittedAt      DateTime?    @db.Date
  publishedAt      DateTime?    @db.Date
  grantedAt        DateTime?    @db.Date
}

model Patent {
  id               String       @id @default(uuid())
  researchWorkId   String       @unique
  researchWork     ResearchWork @relation(fields: [researchWorkId], references: [id], onDelete: Cascade)
  inventors        String
  applicant        String
  applicationNo    String?
  filedAt          DateTime?    @db.Date
  submittedAt      DateTime?    @db.Date
  publishedAt      DateTime?    @db.Date
  publicationLink  String?
  grantedAt        DateTime?    @db.Date
  patentLink       String?
  country          String?
}

model Transaction {
  id               String          @id @default(uuid())
  researchWorkId   String          @unique
  researchWork     ResearchWork    @relation(fields: [researchWorkId], references: [id], onDelete: Cascade)
  transactionName  String
  typeOfTransaction String?
  indexOfTransaction String?
  impactFactor     Float?
  impactFactorDate DateTime?       @db.Date
  publisher        String?
  status           PublicationStatus
  statusDate       DateTime        @db.Date
  paperLinkDOI     String?
  registrationFees Float?
  reimbursementStatus String?
}

model Conference {
  id               String          @id @default(uuid())
  researchWorkId   String          @unique
  researchWork     ResearchWork    @relation(fields: [researchWorkId], references: [id], onDelete: Cascade)
  mode             String? // Online / Offline
  conferenceName   String
  typeOfConference String?
  indexOfConference String?
  publisher        String?
  status           PublicationStatus
  statusDate       DateTime        @db.Date
  paperLinkDOI     String?
  registrationFees Float?
  reimbursementStatus String?
}

model Journal {
  id               String          @id @default(uuid())
  researchWorkId   String          @unique
  researchWork     ResearchWork    @relation(fields: [researchWorkId], references: [id], onDelete: Cascade)
  journalName      String
  typeOfJournal    String?
  indexOfJournal   String?
  impactFactor     Float?
  impactFactorDate DateTime?       @db.Date
  publisher        String?
  status           PublicationStatus
  statusDate       DateTime        @db.Date
  paperLinkDOI     String?
  registrationFees Float?
  reimbursementStatus String?
}

model BookChapter {
  id               String          @id @default(uuid())
  researchWorkId   String          @unique
  researchWork     ResearchWork    @relation(fields: [researchWorkId], references: [id], onDelete: Cascade)
  status           PublicationStatus
  registrationFees Float?
  reimbursementStatus String?
  isbnIssn         String?
}

model GrantIn {
  id               String       @id @default(uuid())
  researchWorkId   String       @unique
  researchWork     ResearchWork @relation(fields: [researchWorkId], references: [id], onDelete: Cascade)
  projectCode      String?
  projectPI        String?
  projectCoPI      String?
  status           String?
  appliedAt        DateTime?    @db.Date
  grantedAt        DateTime?    @db.Date
  durationMonths   Int?
  grantAmount      Float?
  utilizedAmount   Float?
  remainingAmount  Float?
  publication      String?
  publicationDetails String?
}

model FDP {
  id               String       @id @default(uuid())
  researchWorkId   String       @unique
  researchWork     ResearchWork @relation(fields: [researchWorkId], references: [id], onDelete: Cascade)
  name             String
  organizedBy      String?
  duration         String?
  startDate        DateTime?    @db.Date
  endDate          DateTime?    @db.Date
  topic            String?
  remarks          String?
}

model Certification {
  id               String       @id @default(uuid())
  researchWorkId   String       @unique
  researchWork     ResearchWork @relation(fields: [researchWorkId], references: [id], onDelete: Cascade)
  name             String
  certificationName String
  offeredBy        String?
  completedAt      DateTime?    @db.Date
  link             String?
  remarks          String?
}

// =======================================================
// ACHIEVEMENTS
// =======================================================

model Achievement {
  id          String   @id @default(uuid())
  title       String
  description String?
  imageUrl    String
  uploadedAt  DateTime @default(now())
  isPublished Boolean  @default(false)
  link        String?
  uploadedById String
  uploadedBy  User     @relation(fields: [uploadedById], references: [id])
}

// =======================================================
// STUDENT PROJECTS & PAPERS
// =======================================================

model ResearchPaper {
  id              String             @id @default(uuid())
  studentId       String
  student         Student            @relation(fields: [studentId], references: [id], onDelete: Cascade)
  title           String
  abstract        String?
  image           String?
  fileUrl         String?
  status          ResearchPaperStatus @default(UPLOADED)
  createdAt       DateTime           @default(now()) 
  updatedAt       DateTime           @updatedAt
  projectType     ProjectType @default(PERSONAL)
  keywords        String[]
  facultyAdvisors User[] @relation("ResearchPaperAdvisors")
  members         User[] @relation("ResearchPaperMembers")
}

model OngoingProject {
  id              String        @id @default(uuid())
  studentId       String
  student         Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  title           String
  abstract        String?
  image           String?
  filepath        String?
  status          OngoingProjectStatus @default(ONGOING)
  startDate       DateTime?    @db.Date
  endDate         DateTime?    @db.Date
  createdAt       DateTime      @default(now()) 
  updatedAt       DateTime      @updatedAt

  keywords        String[]
  facultyAdvisors User[] @relation("OngoingProjectAdvisors")
  members         User[] @relation("OngoingProjectMembers")
}

// =======================================================
// NEW ADDITIONS
// =======================================================

model LegacyUser {
  id        String   @id @default(uuid())
  email     String   @unique
  fullName  String
  userType  UserType
  createdAt DateTime @default(now())

  @@index([userType])
}

model UpcomingCompetition {
  id               String    @id @default(uuid())
  title            String
  description      String?
  startDate        DateTime
  endDate          DateTime?
  location         String?
  organizer        String?
  prizeDetails     String?
  registrationLink String?
  isPublished      Boolean   @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([startDate])
}

// =======================================================
// NEXTAUTH MODELS (Required for NextAuth.js)
// =======================================================

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
